# Central Server Configuration
PROJECT_NAME="RELAY Emergency Coordination System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Environment: "development", "testing", or "production"
ENVIRONMENT="development"

# Security
SECRET_KEY="temporary-secret-key-change-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite Async URL for zero-dependency local development:
DATABASE_URL="sqlite+aiosqlite:///./relay_central.db"
# PostgreSQL Async URL for production / Docker:
# DATABASE_URL="postgresql+asyncpg://relay_user:relay_password@localhost:5432/relay_db"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
